        }

        private int contarFolhasRecursivo(No noAtual){
            if(noAtual == null){
                return 0;
            }

            if(noAtual.esquerdo == null && noAtual.direito == null){
                return 1;
            }

            return contarFolhasRecursivo(noAtual.direito) + contarFolhasRecursivo(noAtual.esquerdo);
        }

