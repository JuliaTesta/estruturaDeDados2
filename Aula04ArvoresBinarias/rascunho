        private boolean estaBalanceadaRecursivo(No noAtual){
            if(noAtual == null){
                return true;
            }

            int alturaEsq = alturaRecursiva(noAtual.esquerdo);
            int alturaDir = alturaRecursiva(noAtual.direito);

            if(Math.abs(alturaEsq - alturaDir) > 1){
                return false;
            }

            //verifica para os filhos
            return estaBalanceadaRecursivo(noAtual.direito) && estaBalanceadaRecursivo(noAtual.esquerdo);
        }  

        //É ABB válida
        public boolean ehABB(){
            return ehABBRecursiva(raiz, Integer.MIN_VALUE, Integer.MAX_VALUE);
        }

        private boolean ehABBRecursiva(No noAtual, int min, int max){
            if(noAtual == null){
                return true;
            }

            if(noAtual.valor <= min || noAtual.valor >= max){
                return false;
            }

            return ehABBRecursiva(noAtual.esquerdo, min, noAtual.valor) && ehABBRecursiva(noAtual.direito, noAtual.valor, max);
        }

        //Menor ancestral Comum
        public No menorAncestralComum(int v1, int v2){
            No atual = raiz;

            while(atual != null){
                if(v1 < atual.valor && v2 < atual.valor){
                    //Ambos estão a esquerda, desce
                    atual = atual.esquerdo;
                }
                else if(v1 > atual.valor && v2 > atual.valor){
                    //Ambos estao a direita, desce
                    atual = atual.direito;
                }
                else {
                    return atual;
                }
            }
            return null; //nao encontrou, um dos valores pode nao estar na arvore
        }